# Agentic Binance - Environment Variables
# Copy this file to .env and fill in your real keys.
# NEVER commit the real .env file.

# Binance Futures API (https://www.binance.com/en/my/settings/api)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# DeepSeek API (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# App settings
# true  = use Binance Futures Testnet (safe, no real money)
# false = use Binance Futures Mainnet (REAL money - be careful)
USE_TESTNET=true

# Risk manager (percent values, e.g. 0.5 = 0.5%)
# Conservative profile. Change these only after you understand the effect.
RISK_PER_TRADE_PCT=0.5
MAX_LEVERAGE=5
MAX_NOTIONAL_PCT=20
DAILY_LOSS_LIMIT_PCT=3
MAX_OPEN_POSITIONS=3
MIN_CONVICTION=60
STOP_ATR_MULT=1.5
STOP_MIN_PCT=0.3
STOP_MAX_PCT=3
REWARD_RATIO=2